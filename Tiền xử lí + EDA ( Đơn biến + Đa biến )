      "source": [
        "**- Dùng biểu đồ Box Plot để trực quan các biến có Outliers:**"
      ],
      "metadata": {
        "id": "E18bX4sMBwbK"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "num_cols = ['Number_of_Casualties', 'Number_of_Vehicles', 'Age_of_Vehicle', 'Engine_Capacity_CC']\n",
        "\n",
        "sns.set_style(\"whitegrid\")\n",
        "sns.set_palette(\"husl\")\n",
        "\n",
        "fig, axes = plt.subplots(2, 2, figsize=(16, 8))\n",
        "axes = axes.flatten()\n",
        "\n",
        "for idx, (ax, col) in enumerate(zip(axes, num_cols)):\n",
        "    # Tính toán outlier\n",
        "    Q1 = merged_data[col].quantile(0.25)\n",
        "    Q3 = merged_data[col].quantile(0.75)\n",
        "    IQR = Q3 - Q1\n",
        "    lower_bound = Q1 - 1.5 * IQR\n",
        "    upper_bound = Q3 + 1.5 * IQR\n",
        "\n",
        "    outlier_count = merged_data[\n",
        "        (merged_data[col] < lower_bound) | (merged_data[col] > upper_bound)\n",
        "    ].shape[0]\n",
        "\n",
        "    total_count = merged_data.shape[0]\n",
        "    outlier_percentage = (outlier_count / total_count) * 100\n",
        "\n",
        "    # Vẽ boxplot ngang\n",
        "    sns.boxplot(x=merged_data[col],\n",
        "                ax=ax,\n",
        "                orient='h',\n",
        "                width=0.6,\n",
        "                fliersize=5,\n",
        "                linewidth=1.5,\n",
        "                color=f'C{idx}')\n",
        "\n",
        "    ax.set_title(col, fontsize=14, fontweight='bold', pad=12, color='#2C3E50')\n",
        "    ax.set_xlabel('Value', fontsize=11)\n",
        "    ax.set_ylabel('')\n",
        "\n",
        "    # Đặt thông tin outlier ở góc trên phải\n",
        "    ax.text(0.98, 0.95, f'Outlier: {outlier_percentage:.2f}%',\n",
        "            transform=ax.transAxes, fontsize=11, fontweight='bold',\n",
        "            verticalalignment='top', horizontalalignment='right',\n",
        "            bbox=dict(boxstyle='round,pad=0.4', facecolor='white',\n",
        "                     edgecolor=f'C{idx}', alpha=0.9, linewidth=1.5))\n",
        "\n",
        "    stats_text = f'Q1: {Q1:.1f} | Q3: {Q3:.1f}\\nIQR: {IQR:.1f}'\n",
        "    ax.text(0.02, 0.95, stats_text,\n",
        "            transform=ax.transAxes, fontsize=9,\n",
        "            verticalalignment='top', horizontalalignment='left',\n",
        "            bbox=dict(boxstyle='round,pad=0.3', facecolor='whitesmoke', alpha=0.7))\n",
        "\n",
        "    ax.grid(True, linestyle='--', alpha=0.3, axis='x')\n",
        "    ax.set_axisbelow(True)\n",
        "\n",
        "    if col == 'Engine_Capacity_CC':\n",
        "        ax.xaxis.set_major_formatter(plt.FuncFormatter(lambda x, p: f'{int(x):,}'))\n",
        "\n",
        "plt.tight_layout(pad=3.0)\n",
        "fig.suptitle('Horizontal Boxplot Analysis with Outlier Detection',\n",
        "             fontsize=16, fontweight='bold', y=1.02)\n",
        "plt.show()"
      ],
