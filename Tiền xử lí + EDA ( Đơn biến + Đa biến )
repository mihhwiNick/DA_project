      "cell_type": "code",
      "source": [
        "# Tạo biến Time_period theo Hour\n",
        "def assign_time_period(hour):\n",
        "    if pd.isna(hour):\n",
        "        return None\n",
        "    if 5 <= hour < 10:\n",
        "        return 'Sáng sớm'\n",
        "    elif 10 <= hour < 15:\n",
        "        return 'Ban ngày'\n",
        "    elif 15 <= hour < 19:\n",
        "        return 'Chiều tối'\n",
        "    elif 19 <= hour < 23:\n",
        "        return 'Tối'\n",
        "    else:\n",
        "        return 'Khuya'\n",
        "\n",
        "merged_data['Time_period'] = merged_data['Hour'].apply(assign_time_period)"
      ],
